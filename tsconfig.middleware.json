{
  // `middleware.ts` sits at the repo root, runs on Vercel's Edge runtime, and is
  // never imported by the app — so `tsconfig.json`'s `include` (`["src","tests"]`)
  // misses it, and widening that to the root would drag in `vite.config.ts` &c.
  // Hence its own project, describing the Edge runtime rather than the app:
  //   - `types: []` — no @types/* in scope, so the file's own `process`
  //     declaration is the only one, exactly as it is when Vercel runs it;
  //   - `lib: ["ES2022","DOM"]` — supplies precisely the globals it uses
  //     (`crypto.subtle`, `btoa`, `TextEncoder`, `Request`/`Response`, `URL`),
  //     with no Node or app ambients to lean on by accident.
  // Referenced from `tsconfig.json`, so `npm run typecheck` (`tsc -b`) covers it
  // and it cannot silently fall out of the checked set again.
  "compilerOptions": {
    "composite": true,
    "outDir": "./node_modules/.tmp/tsconfig-middleware",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "types": [],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  // `src/deck-variants.ts` is listed because the gate imports it (gh#23) and a
  // composite project must list every file in its program. It is also part of
  // the app project — deliberate: the table is the one thing both sides share,
  // so it is checked twice, and here with `types: []`, which is what catches a
  // Node- or Vite-ambient dependency creeping into it. DOM types ARE in scope
  // here (the `lib` above), so DOM misuse is caught by the import-free test in
  // `tests/unit/deck-variants.test.ts`, not by this project.
  "include": ["middleware.ts", "src/deck-variants.ts"]
}
